{
  "name": "@hive/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "description": "Hive mobile — a thin remote React Native (Expo) client that drives a self-hosted Hive backend over the same WS JSON-RPC via @hive/client. No terminal, no editor.",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hive/client": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.3",
    "expo-notifications": "~0.29.11",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
